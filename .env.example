# Gemini API 키를 넣는 곳 (견본). 이 파일을 .env.local로 복사한 뒤 = 뒤에 내 키를 넣는다.
# 진짜 키는 .env.local에만 넣고, 이 파일에는 절대 넣지 않는다.
GEMINI_API_KEY=

# 카페 전용 Supabase 프로젝트 (구글 로그인 + 도장·쿠폰·미션 저장)
# Supabase 화면 → Project Settings → API Keys 에서 복사한다.
# 공개용(publishable) 키만 넣는다. secret / service_role 키는 절대 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
